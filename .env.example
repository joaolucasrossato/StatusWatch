APP_NAME=StatusWatch
APP_ENV=development

POSTGRES_DB=statuswatch
POSTGRES_USER=statuswatch
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://statuswatch:change_me@db:5432/statuswatch
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

WORKER_MAX_CONCURRENCY=10
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_REDIRECTS=5

# Optional SMTP for notifications. Blank host/from fails deliveries safely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Hourly cleanup; incidents and pending deliveries are preserved.
CHECK_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
