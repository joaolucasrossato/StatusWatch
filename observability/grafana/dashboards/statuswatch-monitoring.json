          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type)(rate(statuswatch_monitor_check_failures_total{job=\"worker\"}[5m]))",
          "legendFormat": "{{error_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Check latency",
      "description": "Seconds; only committed checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
