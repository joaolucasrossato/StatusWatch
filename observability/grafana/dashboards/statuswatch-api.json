{
  "uid": "statuswatch-api",
  "title": "StatusWatch API",
  "tags": [
    "statuswatch",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "statuswatch"
      ],
      "title": "StatusWatch dashboards",
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "All recorded traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(statuswatch_api_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "Request rate",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by route",
      "description": "Template labels; never raw user paths.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route)(rate(statuswatch_api_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by status code",
      "description": "Compare successes, client errors and server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code)(rate(statuswatch_api_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "{{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4xx and 5xx",
      "description": "4xx is a client outcome and counts as available in the availability SLI.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(statuswatch_api_http_requests_total{job=\"api\",status_code=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(statuswatch_api_http_requests_total{job=\"api\",status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Eligible 5xx ratio",
      "description": "No traffic returns no data rather than a fabricated success.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "statuswatch:api_error_ratio5m",
          "legendFormat": "Eligible 5xx ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p50 / p95 / p99",
      "description": "Histogram bucket aggregation preserves le.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le)(rate(statuswatch_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(statuswatch_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le)(rate(statuswatch_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 by route",
      "description": "Route-level tail latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route)(rate(statuswatch_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests in progress by method",
      "description": "Direct gauge, not a rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (statuswatch_api_http_requests_in_progress{job=\"api\"})",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    }
  ]
}
