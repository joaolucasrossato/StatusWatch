        {
          "refId": "B",
          "expr": "sum(rate(statuswatch_notification_delivery_retries_total{job=\"worker\"}[5m]))",
          "legendFormat": "retry",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "API availability / latency SLI (observed 30d)",
      "description": "Initial objectives: 99.9% availability, 99% <=500ms. A new or size-truncated TSDB is a partial window.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
