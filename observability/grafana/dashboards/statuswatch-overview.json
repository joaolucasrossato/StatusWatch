    {
      "id": 11,
      "type": "timeseries",
      "title": "Notification terminal outcomes and retries",
      "description": "Only committed states; sparse series remain no data until events occur.",
      "datasource": {
        "type": "prometheus",
        "uid": "statuswatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
