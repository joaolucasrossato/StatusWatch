        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "statuswatch:api_availability30d",
          "legendFormat": "availability",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "statuswatch:api_latency_good_ratio30d",
          "legendFormat": "<=500ms",
          "datasource": {
            "type": "prometheus",
            "uid": "statuswatch-prometheus"
          },
          "range": true
        }
      ]
    },
